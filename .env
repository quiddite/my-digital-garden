THEME=https://raw.githubusercontent.com/chrisgrieser/shimmering-focus/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=false
dgShowToc=true
dgLinkPreview=false
dgShowTags=true
STYLE_SETTINGS_CSS=body.css-settings-manager { --code-size: 1.05em; --highlight-hue-1: 40; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-macos is-frameless is-hidden-frameless is-maximized obsidian-app show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager normal-tab-bar hide-inline-title-when-more-than-one-tab hide-vault-switcher-and-settings show-sidebar-header-buttons show-suggester-instructions show-sidebar-toggle-buttons show-close-buttons hide-signature-icon colorscheme-gamma active-line-gutter
SITE_NAME_HEADER=Quiddite
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false